# ──────────────────────────────────────────────────────────────────────────────
# HAGO UAS Intelligence & Support Bot — API environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="HAGO UAS Intelligence & Support Bot"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_32_byte_hex_secret

# Database — PostgreSQL with pgvector
DATABASE_URL=******localhost:5432/hago_uas

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers — configure at least one
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TECHNICAL_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307
ANTHROPIC_TECHNICAL_MODEL=claude-3-5-sonnet-20241022

GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-1.5-flash

# Provider priority — first available in the list will be used
AI_PROVIDER_PRIORITY=["openai","anthropic","google"]

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# File uploads
UPLOAD_DIR=/tmp/hago_uploads
MAX_UPLOAD_SIZE_MB=50

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_TOP_K=8
RAG_RERANK_TOP_N=4

# Celery (background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
