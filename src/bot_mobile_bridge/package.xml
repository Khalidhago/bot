<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bot_mobile_bridge</name>
  <version>0.1.0</version>
  <description>Phone teleoperation for the bot: rosbridge websocket plus a self-contained touch-joystick web UI.</description>
  <maintainer email="khalid.hago82@gmail.com">Khalid Hago</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
