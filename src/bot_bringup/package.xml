<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files composing the bot mobile robot system.</description>
  <maintainer email="khalid.hago82@gmail.com">Khalid Hago</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bot_description</exec_depend>
  <exec_depend>bot_base</exec_depend>
  <exec_depend>bot_mobile_bridge</exec_depend>
  <exec_depend>bot_navigation</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
